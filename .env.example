# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...          # from @BotFather
TELEGRAM_WEBHOOK_SECRET=                  # random string, set on setWebhook
TELEGRAM_ALLOWED_USER_ID=                 # your numeric Telegram user id; others ignored

# --- Notion ---
NOTION_TOKEN=ntn_...                      # internal integration token
NOTION_MATERIAL_DB=                       # 资料库 database id（tools/setup_notion.py 会打印）
NOTION_THOUGHT_DB=                        # 想法与笔记 database id

# --- LLM (your own OpenAI-format endpoint; chat/completions only) ---
LLM_BASE_URL=https://your-endpoint/v1
LLM_MODEL=your-model-name
LLM_API_KEY=
LLM_USE_SCHEMA=1                          # set 0 if the gateway rejects response_format

# --- 知乎（可选）---
# d_c0 是知乎发给访客的设备标识，不是登录凭证；从无痕窗口取，别带上 z_c0。
# 留空则知乎链接落「等待采集」。
ZHIHU_DC0=
# Anonymous Zhihu fallback; no Jina API key or billing setup required.
JINA_READER_ENABLED=1
JINA_READER_TIMEOUT=60

# --- GCP ---
GCP_PROJECT=your-gcp-project
GCP_REGION=us-central1
GCS_BUCKET=your-gcp-project-kb-originals
TASKS_QUEUE=kb-bot-queue
SERVICE_URL=                              # filled in by deploy.sh
TASKS_SA_EMAIL=                           # filled in by deploy.sh

# --- 可选 ---
GEMINI_API_KEY=                           # 视频转写（B站/YouTube）；建议用未绑定结算的项目的 key
S2_API_KEY=                               # Semantic Scholar，论文会议名/引用数
CROSSREF_MAILTO=                          # Crossref 礼貌池要求的联系邮箱
USER_TIMEZONE=Asia/Shanghai               # 回复中的时间与每日重试任务使用的时区
LLM_VLLM_HOSTS=                           # 主机名，多个用空格分隔；vLLM 网关上的 DeepSeek 用模板开关关闭思考
